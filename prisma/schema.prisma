generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  displayName String
  role        String
  phoneNormalized String?
  phoneDisplay    String?
  email       String?
  passwordHash String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Staff {
  id          String       @id @default(cuid())
  firstName   String
  lastName    String?
  displayName String
  active      Boolean      @default(true)
  role        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  primaryOpportunities MembershipOpportunity[] @relation("ProposedPrimaryCloser")
  supportOpportunities MembershipOpportunity[] @relation("ProposedSupportCloser")
  therapistOpportunities MembershipOpportunity[] @relation("FirstVisitTherapist")
  primarySales MembershipSale[] @relation("FinalPrimaryCloser")
  supportSales MembershipSale[] @relation("FinalSupportCloser")
  saleCredits SaleCredit[]
  commissionResults CommissionResult[]
}

model Location {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  active        Boolean  @default(true)
  opportunities MembershipOpportunity[]
  sales         MembershipSale[]
}

model MembershipType {
  id     String @id @default(cuid())
  name   String @unique
  active Boolean @default(true)
  sales  MembershipSale[]
}

model Client {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  phoneNormalized String
  phoneDisplay    String
  email           String?
  firstVisitDate  DateTime
  sessionType     String?
  sessionOther    String?
  clientType      String?
  primaryIssue    String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  opportunity     MembershipOpportunity?

  @@index([phoneNormalized])
  @@index([firstName, lastName, firstVisitDate])
}

model MembershipOpportunity {
  id                      String   @id @default(cuid())
  clientId                String   @unique
  locationId              String
  firstVisitTherapistId   String?
  proposedPrimaryCloserId String
  proposedSupportCloserId String?
  collectedBy             String   @default("Primary Closer")
  status                  String   @default("OPEN")
  interestLevel           String   @default("None")
  closureReason           String?
  closureNote             String?
  lastFollowUpDate        DateTime?
  nextFollowUpDate        DateTime?
  followUpOwnerId         String?
  followUpStatus          String   @default("Follow Up Needed")
  followUpNotes           String?
  intakeSubmittedAt       DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  firstVisitTherapist Staff? @relation("FirstVisitTherapist", fields: [firstVisitTherapistId], references: [id])
  proposedPrimaryCloser Staff @relation("ProposedPrimaryCloser", fields: [proposedPrimaryCloserId], references: [id])
  proposedSupportCloser Staff? @relation("ProposedSupportCloser", fields: [proposedSupportCloserId], references: [id])
  sale MembershipSale?
  followUps FollowUp[]

  @@index([status])
  @@index([locationId])
  @@index([firstVisitTherapistId])
  @@index([proposedPrimaryCloserId])
}

model MembershipSale {
  id                    String   @id @default(cuid())
  opportunityId         String   @unique
  locationId            String
  membershipSaleDate    DateTime
  membershipTypeId      String
  finalPrimaryCloserId  String
  finalSupportCloserId  String?
  approvalStatus        String   @default("PENDING")
  isFirstVisitSale      Boolean
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  opportunity MembershipOpportunity @relation(fields: [opportunityId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  membershipType MembershipType @relation(fields: [membershipTypeId], references: [id])
  finalPrimaryCloser Staff @relation("FinalPrimaryCloser", fields: [finalPrimaryCloserId], references: [id])
  finalSupportCloser Staff? @relation("FinalSupportCloser", fields: [finalSupportCloserId], references: [id])
  credits SaleCredit[]

  @@index([membershipSaleDate])
  @@index([approvalStatus])
  @@index([isFirstVisitSale])
}

model SaleCredit {
  id                    String   @id @default(cuid())
  saleId                String
  staffId               String
  creditBasisPoints     Int
  creditUnits           Decimal
  firstVisitCreditUnits Decimal @default(0)
  createdAt             DateTime @default(now())

  sale MembershipSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([saleId, staffId])
  @@index([staffId])
}

model FollowUp {
  id            String   @id @default(cuid())
  opportunityId String
  followUpDate  DateTime
  ownerId       String?
  status        String
  notes         String?
  createdAt     DateTime @default(now())

  opportunity MembershipOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

model CommissionPeriod {
  id        String   @id @default(cuid())
  month     String   @unique
  status    String   @default("OPEN")
  finalizedAt DateTime?
  reopenedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  results   CommissionResult[]
}

model CommissionResult {
  id                     String   @id @default(cuid())
  periodId               String
  staffId                String
  fullSaleCount          Int
  splitCreditUnits       Decimal
  totalCredits           Decimal
  firstVisitCredits      Decimal
  baseCommissionCents    Int
  firstVisitBonusCents   Int
  adjustmentsCents       Int      @default(0)
  finalCommissionCents   Int
  approvalStatus         String   @default("FINAL")
  createdAt              DateTime @default(now())

  period CommissionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([periodId, staffId])
}

model CommissionSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  value       String
  editableBy  String   @default("ADMINISTRATOR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CrmStepTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  content   String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id            String   @id @default(cuid())
  actingUser    String
  action        String
  recordType    String
  recordId      String
  previousValue String?
  newValue      String?
  reason        String?
  createdAt     DateTime @default(now())

  @@index([recordType, recordId])
  @@index([createdAt])
}
